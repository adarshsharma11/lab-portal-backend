{
  "name": "lab-portal-backend",
  "version": "1.0.0",
  "description": "Pathology LIS / LIMS Backend API",
  "main": "dist/index.js",
  "prisma": {
    "seed": "node --require esbuild-register prisma/seed.ts"
  },
  "scripts": {
    "seed": "npx prisma db seed",
    "build": "tsc && prisma generate",
    "start": "node dist/index.js",
    "vercel-build": "prisma generate",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "keywords": ["lims", "lis", "pathology", "lab-portal"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.8.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "esbuild": "^0.19.11",
    "esbuild-register": "^3.5.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
